<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>HexUploader</AssemblyName>
    <RootNamespace>HexUploader</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>

  <!-- The SDK's default None glob already contains Avrdude\*; pull the binaries out of
       None so they can be declared Content (Content Update alone matches nothing). -->
  <ItemGroup>
    <None Remove="Avrdude\avrdude.exe" />
    <None Remove="Avrdude\libusb0.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Avrdude\avrdude.conf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Avrdude\avrdude.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Avrdude\libusb0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
