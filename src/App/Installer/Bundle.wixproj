<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>Fcc3ControllerSetup</OutputName>
    <ProductVersion>1.0.3</ProductVersion>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Product.wxs belongs to Installer.wixproj; opt out of the default **/*.wxs glob. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WixStandardBootstrapperApplication + DotNetCoreSearch -->
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
    <ProjectReference Include="Installer.wixproj" />
  </ItemGroup>

</Project>
