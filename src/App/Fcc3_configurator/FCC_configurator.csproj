<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FCC_configurator</AssemblyName>
    <RootNamespace>Fcc3_configurator</RootNamespace>
    <ApplicationIcon>Icon_small.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <StartupObject>Fcc3_configurator.Program</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- CA1416 is a false positive here: GenerateAssemblyInfo=false also suppresses the
         SDK-generated [assembly: TargetPlatform] attribute, so the analyzer assumes
         "all platforms". This WinForms app is Windows-only by construction. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <!-- System.Configuration.ConfigurationManager ships in the .NET 10 Windows Desktop
         shared framework, so no explicit PackageReference is needed (NU1510). -->
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GithubUpdater\GithubUpdater.csproj" />
    <ProjectReference Include="..\HexUploader\HexHelper.csproj" />
  </ItemGroup>

</Project>
