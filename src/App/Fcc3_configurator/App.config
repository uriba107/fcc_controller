<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager">
            <section name="Fcc3_configurator.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <userSettings>
        <Fcc3_configurator.Properties.Settings>
            <setting name="gOptions" serializeAs="String">
                <value>16</value>
            </setting>
            <setting name="gUserDefinedForce" serializeAs="String">
                <value>3.0</value>
            </setting>
            <setting name="gForceUnitlbf" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="notifyApp" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="notifyFirmware" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="UseNewFccGain" serializeAs="String">
                <value>False</value>
            </setting>
        </Fcc3_configurator.Properties.Settings>
    </userSettings>
</configuration>
